{
  "name": "ai-assistant-addon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "prebuild": "tsx scripts/release-source-binding.ts",
    "build": "tsc -p tsconfig.build.json && vite build && tsx scripts/generate-release-artifact-manifest.ts",
    "start": "node dist/server/server.js",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "type-check:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "test": "npm run build && vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "perf:local-ui": "npm run build && tsx scripts/performance/local-ui-gate.ts",
    "perf:private-production": "tsx scripts/performance/private-production-gate.ts",
    "perf:private-production:secure": "tsx scripts/performance/run-private-production-secure.ts",
    "media:marketplace": "npm run build && tsx scripts/generate-marketplace-media.ts",
    "test:watch": "vitest",
    "cycles": "madge --circular --extensions ts --ts-config tsconfig.json src",
    "dup": "jscpd",
    "lint": "eslint src scripts --max-warnings 0",
    "generate:scope-contract": "tsx scripts/generate-endpoint-scope-contract.ts",
    "check:scope-contract": "tsx scripts/generate-endpoint-scope-contract.ts --check",
    "generate:api-action-inventory": "tsx scripts/generate-api-action-inventory.ts",
    "check:api-action-inventory": "tsx scripts/generate-api-action-inventory.ts --check",
    "check:deepseek-evidence": "tsx scripts/evidence/deepseek-release-evidence.ts",
    "bind:deepseek-evidence": "tsx scripts/evidence/deepseek-release-evidence.ts --write-binding",
    "check:operational-evidence": "tsx scripts/evidence/operational-release-evidence.ts",
    "check:private-production-evidence": "tsx scripts/evidence/private-production-release-evidence.ts",
    "check:live-browser-evidence": "tsx scripts/evidence/live-browser-acceptance.ts",
    "check:reviewed-pr-evidence": "tsx scripts/evidence/reviewed-pr-evidence.ts",
    "record:cold-verifies": "tsx scripts/evidence/cold-verify-evidence.ts",
    "record:live-browser-evidence": "tsx scripts/evidence/record-live-browser-acceptance.ts",
    "import:release-evidence": "tsx scripts/evidence/import-release-evidence.ts",
    "gate:predeploy-backup": "tsx scripts/evidence/predeploy-backup-gate.ts",
    "evidence:marketplace-media-binding": "tsx scripts/evidence/marketplace-media-binding.ts",
    "probe:scopes": "tsx scripts/live-scope-probe.ts",
    "probe:member-denial": "tsx scripts/live-member-denial-probe.ts",
    "manifest:hash": "tsx scripts/manifest-hash.ts",
    "release:validate-base-url": "tsx scripts/validate-release-base-url.ts",
    "deploy:private-production": "tsx scripts/deploy-private-production.ts",
    "verify": "npm run type-check && npm run type-check:scripts && npm run check:scope-contract && npm run check:api-action-inventory && npm run lint && npm run cycles && npm run dup && npm test",
    "eval:smoke": "vitest run tests/integration/eval-smoke.test.ts",
    "eval:api-discovery": "tsx scripts/eval-api-discovery.ts",
    "eval:assistant-terminal": "tsx scripts/eval-assistant-terminal.ts",
    "eval:write-safety": "tsx scripts/eval-write-safety.ts",
    "live:v2-full": "tsx scripts/live-v2-full.ts",
    "live:sweep": "tsx scripts/live-sweep.ts",
    "audit:prod": "tsx scripts/dependency-gates/audit-prod.ts",
    "license:prod": "tsx scripts/dependency-gates/license-prod.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:capture-backup-boundary": "tsx scripts/capture-backup-boundary.ts",
    "db:bind-legacy-backup-metadata": "tsx scripts/bind-legacy-backup-metadata.ts",
    "db:restore": "tsx scripts/restore-db.ts",
    "db:verify-restore": "npm run build 1>&2 && tsx scripts/verify-restored-db.ts"
  },
  "dependencies": {
    "@apet97/clockify-addon-sdk": "file:vendor/apet97-clockify-addon-sdk-1.0.0.tgz",
    "@js-temporal/polyfill": "0.5.1",
    "better-sqlite3": "^12.10.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.0",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/spdx-expression-parse": "4.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.5.0",
    "jscpd": "^4.0.5",
    "madge": "^8.0.0",
    "spdx-expression-parse": "4.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "form-data": "^4.0.6"
  }
}
