{
  "name": "ai-assistant-addon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "node dist/server/server.js",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "type-check:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cycles": "madge --circular --extensions ts --ts-config tsconfig.json src",
    "dup": "jscpd",
    "lint": "eslint src",
    "verify": "npm run type-check && npm run lint && npm run cycles && npm run dup && npm test && npm run build",
    "eval:smoke": "vitest run tests/integration/eval-smoke.test.ts"
  },
  "dependencies": {
    "@apet97/clockify-addon-sdk": "file:vendor/apet97-clockify-addon-sdk-1.0.0.tgz",
    "better-sqlite3": "^12.10.0",
    "express": "^4.19.2",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.5.0",
    "jscpd": "^4.0.5",
    "madge": "^8.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "form-data": "^4.0.6"
  }
}
