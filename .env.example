# AI Assistant for Clockify — environment template.
# Copy to `.env` and fill in real values. Never commit the real `.env`.

# Runtime
NODE_ENV=development
PORT=3001

# Public base URL where this add-on is reachable (used for cookies + manifest).
BASE_URL=https://your-addon.example.com

# Clockify add-on identity / token verification
CLOCKIFY_ADDON_KEY=ai-assistant
# OPTIONAL. Clockify signs every add-on token (component `auth_token` and the
# `x-addon-lifecycle-token`) with one platform-wide RS256 key. That key is built
# in (src/addon/clockify-public-key.ts), so the add-on verifies install/lifecycle
# tokens out of the box — leave this unset. It is NOT a per-add-on/dev-console
# key. Only set it to point at a non-production Clockify environment/region.
# CLOCKIFY_ADDON_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Secrets (generate strong random values)
SESSION_SECRET=replace-with-a-long-random-string
# Signed-session lifetime in hours (default 2). Also the authz-surface-01 role-staleness
# bound: a demoted admin keeps access until the session expires. Lower = tighter
# revocation but a shorter "Chats" history window (it lists only live sessions). See SECURITY.md.
# SESSION_TTL_HOURS=2
# ROLE_RECHECK=0          # 1 = re-verify Clockify admin role on every /api request (authz-surface-01)
# ROLE_RECHECK_TTL_MS=60000
# Secret passphrase used to derive the AES-256-GCM key for installation tokens at
# rest (SHA-256 of this value is the key). Use a strong random secret, min 32 chars
# (e.g. `openssl rand -hex 32` gives 64 chars). NOT interpreted as raw hex bytes.
DATA_ENCRYPTION_KEY=replace-with-a-strong-secret-min-32-chars
# During a key rotation only: set the old key here and the new key above. Startup
# re-encrypts every installation token transactionally; remove this after one
# successful deploy and a verified backup.
# DATA_ENCRYPTION_KEY_PREVIOUS=replace-with-the-previous-secret-min-32-chars

# Storage
DATABASE_PATH=./data/ai-assistant.sqlite

# Model endpoint (OpenAI-compatible chat completions). The model never receives tokens or secrets.
LLM_BASE_URL=https://your-llm-endpoint.example.com
LLM_API_KEY=replace-with-model-api-key
LLM_MODEL=your-model-name

# Optional planner knobs (defaults shown; leave unset to use the default).
# Planner backend: "http" (OpenAI-compatible endpoint above) or "gemini-cli" (dev).
# LLM_PROVIDER=http
# Planner mode: "tool" (native function-calling) or "json" (JSON + repair).
# LLM_MODE=tool
# Durable agentic loop: "1" = ON (read-then-act + resume across confirm). "0" =
# byte-identical single-turn rollback.
# LLM_AGENTIC=1
# Deterministic tool subsetting (weak-model consistency): "1" (default) shows the
# model only the actions relevant to the message (+ an always-on core); "0" shows all
# (the rollback). Default ON after the agentic eval (DeepSeek 100% held, ~61% fewer
# prompt tokens/turn, 0 safety).
# LLM_TOOL_SELECT=1
# Per-request model timeout in ms (a hung provider aborts instead of hanging the
# chat turn). Generous default — thinking mode is slow on long transcripts.
# LLM_TIMEOUT_MS=120000
# Clockify commit/IO request timeout in ms (default 120000). MUST be < 290000 so it
# stays below the idempotency claim TTL. Leave unset unless you know you need it.
# COMMIT_TIMEOUT_MS=120000
# Retention window (DAYS) for chat transcripts + the audit log. Default 90, min 30
# (the metrics default window is 30 days, so a lower value would truncate it).
# RETENTION_DAYS=90
# Chat rate limit per admin session (each turn drives a paid model loop).
# CHAT_RATE_LIMIT_MAX=30
# CHAT_RATE_LIMIT_WINDOW_MS=300000
# New-chat (session-creation) rate limit per admin — bounds resetting the per-session
# paid-loop budget by minting fresh sessions via POST /chat/new.
# NEW_CHAT_RATE_LIMIT_MAX=10
# NEW_CHAT_RATE_LIMIT_WINDOW_MS=300000
# Model for the gemini-cli provider (else the CLI router picks). Only used when
# LLM_PROVIDER=gemini-cli.
# GEMINI_MODEL=gemini-2.5-flash
# LLM_REASONING_EFFORT=none
# Optional sampling seed (OpenAI-compatible `seed`) — providers that honor it make
# temperature-0 runs more reproducible (extra run-to-run consistency on weak models).
# LLM_SEED=7
